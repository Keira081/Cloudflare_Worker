/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-31",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"durable_objects": {
		"bindings": [
			{
				"name": "SESSION_DO",
				"class_name": "SessionDO",
			},
		],
	},
	// Tells Cloudflare which storage backend each DO class gets.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["SessionDO"], // each SessionDO instance gets its own SQLite database
		},
		// done once per class
	],
	"workflows": [
		{
			"name": "RESEARCH_WORKFLOW",
			"binding": "RESEARCH_WORKFLOW", // name used on `env` in code
			"class_name": "ResearchWorkflow",
		},
	],
	"ai": {
		"binding": "AI",
	},

	// Secrets (e.g. OPENALEX_MAILTO) don't go in this file
	// use .dev.vars locally and `npx wrangler secret put <NAME>` in production.
	// https://developers.cloudflare.com/workers/configuration/secrets/
}
